# Linux without Docker. Install to /etc/systemd/system/jobhunt.service
#   sudo systemctl enable --now jobhunt
[Unit]
Description=jobhunt scheduler and web console
After=network-online.target

[Service]
Type=simple
User=kai
WorkingDirectory=/home/kai/jobhunt
EnvironmentFile=/home/kai/jobhunt/.env
ExecStart=/usr/bin/python3 -m jobhunt daemon --with-web --host 127.0.0.1 --port 8000
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
