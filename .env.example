# cp .env.example .env, fill these in, and keep .env out of git.
# Nothing here is ever stored in the database.

# Gmail App Password — NOT your account password.
# Generate at https://myaccount.google.com/apppasswords (needs 2FA enabled).
JOBHUNT_SMTP_PASSWORD=

# Login for the web console. Required before the app will bind to anything
# other than localhost, because the settings page holds your email address.
JOBHUNT_WEB_PASSWORD=

# Signs session cookies so you stay logged in across restarts.
# Generate one with:  openssl rand -hex 32
JOBHUNT_SECRET_KEY=

# Optional — where the SQLite database lives. Defaults to ./jobs.db,
# and the Docker image sets it to /data/jobs.db on the mounted volume.
# JOBHUNT_DB=/data/jobs.db
